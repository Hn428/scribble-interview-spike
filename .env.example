# Copy to .env.local and fill in. Never commit real keys.

# --- OpenAI -----------------------------------------------------------------
# Enables OpenAI mode. If unset, the workflow runs in deterministic mock mode.
OPENAI_API_KEY=
# Optional. Defaults to gpt-4.1-mini (cost-effective) when unset.
OPENAI_MODEL=gpt-4.1-mini

# --- Langfuse observability -------------------------------------------------
# Set BOTH keys to enable Langfuse tracing (observabilityMode: "langfuse").
# If either is missing, the workflow still runs with observabilityMode: "disabled".
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
